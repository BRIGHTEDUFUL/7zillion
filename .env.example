# ─────────────────────────────────────────────────────────────
# Seven Zillions — environment variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Convex ───────────────────────────────────────────────────
# Get this from https://dashboard.convex.dev → your project → Settings → URL
CONVEX_URL=https://your-deployment.convex.cloud

# Deploy key — required to call internalMutation / internalQuery from the server.
# Get this from https://dashboard.convex.dev → your project → Settings → Deploy key
# Keep this SECRET — treat it like a database password.
# Preferred location: .env.local (git-ignored, and written there by `npx convex deployment token create`)
CONVEX_DEPLOY_KEY=your-deploy-key-here

# HTTP Actions base URL of the same deployment (https://<name>.convex.site).
# Only needed if you add `httpAction`s in convex/; unused by the app today.
CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Admin credentials ─────────────────────────────────────────
# The username the admin panel login form accepts
ADMIN_USERNAME=admin

# bcrypt hash of the admin password (cost factor 10 recommended)
# Generate with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_REAL_HASH

# ── Node / Hostinger ──────────────────────────────────────────
# Port the Node.js server listens on (Hostinger typically assigns this)
PORT=3000

# Do NOT set NODE_ENV here. Vite loads .env during `vite build` and `vite dev`,
# so NODE_ENV=development in this file compiles production JSX with jsxDEV and
# the built server crashes with "jsxDEV is not a function". Vite picks the value
# from the mode; set NODE_ENV=production in the Hostinger environment panel
# (runtime only), where it does not affect the build.
